{
  "name": "untrace-desktop",
  "description": "Offline image metadata cleaner for Windows with a dedicated desktop workspace.",
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "build:desktop": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop": "npm run build:desktop && electron .",
    "portable": "npm run build:desktop && node scripts/build-windows.mjs portable",
    "test": "npm run build:desktop && playwright test",
    "installer": "npm run build:desktop && node scripts/build-windows.mjs nsis",
    "release:windows": "npm run build:desktop && node scripts/build-windows.mjs",
    "screenshots": "npm run build:desktop && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "gh-pages": "^6.1.0",
    "lightningcss": "^1.30.1",
    "svelte": "^4.2.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "exifr": "^7.1.3"
  },
  "homepage": "https://github.com/donishki/Untrace",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "author": "developersharif",
  "build": {
    "appId": "local.untrace.desktop",
    "productName": "Untrace Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signExecutable": false,
      "icon": "desktop/icon.ico"
    },
    "portable": {
      "artifactName": "Untrace-Desktop-${version}-portable-${arch}.exe"
    },
    "extraFiles": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE-Untrace.txt"
      },
      {
        "from": "THEME-CREDITS.md",
        "to": "THEME-CREDITS.md"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Untrace-Desktop-${version}-setup-${arch}.exe",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "LICENSE"
    },
    "compression": "normal"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/donishki/Untrace.git"
  },
  "bugs": {
    "url": "https://github.com/donishki/Untrace/issues"
  },
  "contributors": [
    "Dario P. (Untrace Desktop)"
  ]
}
